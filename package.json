{
  "name": "sdd-claude-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework open source de Spec-Driven Development para Claude Code",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
